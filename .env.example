# Copy to .env on the host. Never commit .env.
BOT_USERNAME=
# New account? Leave BOT_PASSWORD empty and set REGISTER_EMAIL.
BOT_PASSWORD=
REGISTER_EMAIL=
OWNER=YourMinecraftName

# Name of the home set at your base (backup for the bed)
HOME_NAME=base

# First-time setup flies the nether until this x (/tpa works past 2000)
FLY_TARGET_X=2100

# Seconds between uses. Defaults match 21 lifetime votes (7 min / 5 min).
# 49 votes: 120 / 90.   210 votes: 30 / 15.
TPA_COOLDOWN=420
HOME_COOLDOWN=300

# true = only !kit from whitelisted players (the owner always works). Manage the list in game:
#   /w BotName !wl add Steve    !wl remove Steve    !wl list    (also !allow / !unallow)
# Whitelisted players can /tpa to the bot and it accepts, even from spawn.
WHITELIST_ONLY=false

# Items the bot may lose to /kill after a delivery. If it carries anything else it goes home
# with /home instead, so it never throws your gear away. Regex, matched on item names.
# EXPENDABLE=^(elytra|firework_rocket|obsidian|flint_and_steel|(diamond|netherite)_pickaxe)$

QUEUE_MAX=10
DAILY_LIMIT=20
ONE_KIT_PER_PLAYER=true
# true = also accept !kit typed in public chat, not only whispers
PUBLIC_COMMANDS=false

# Optional regexes, filled in once you have seen the real server messages
# WHISPER_PATTERN=^(\w{3,16}) whispers: (.*)$
# TPA_DENIED_PATTERN=

AUTO_UPDATE=true
UPDATE_INTERVAL=60

# 6b6t's captcha must be opened from the bot's own network. If the host is a datacenter,
# route the bot through a SOCKS5 proxy on your own connection and do the captcha there.
# PROXY=socks5://user:pass@your-address:1080
# Get the verify link as a Discord message (channel settings > Integrations > Webhooks)
# DISCORD_WEBHOOK=
# Seconds to wait after a verification kick before retrying (default 1800, minimum 60)
# VERIFY_RETRY=1800
